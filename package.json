{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:gcp": "node scripts/build-gcp.mjs",
    "dev": "nuxt dev",
    "dev:local": "node scripts/dev-local.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:gcp": "node scripts/migrate-sqlite.mjs",
    "db:migrate:prod": "wrangler d1 migrations apply folder-demo --remote",
    "deploy": "npm run build && wrangler deploy && npm run db:migrate:prod",
    "start:gcp": "node scripts/validate-gcp-env.mjs && node scripts/prepare-persistent-storage.mjs && node scripts/migrate-sqlite.mjs && node .output/server/index.mjs",
    "storage:set": "node scripts/set-organization-storage.mjs",
    "storage:backup": "node scripts/backup-local-storage.mjs",
    "storage:restore": "node scripts/restore-local-storage.mjs",
    "storage:cleanup-vectors": "node scripts/cleanup-orphan-vectors.mjs",
    "verify:gcp": "node --test --test-isolation=none tests/*.test.mjs",
    "verify:gcp:runtime": "npm run build:gcp && node --test tests/runtime/gcp-built-runtime.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@formkit/auto-animate": "^0.8.2",
    "@google-cloud/storage": "^7.21.0",
    "@iconify-json/lucide": "^1.2.26",
    "@iconify-json/simple-icons": "^1.2.26",
    "@nuxt/ui": "3.0.0",
    "@nuxthub/core": "^0.8.17",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pdf": "^2.0.10",
    "@vue-office/pptx": "^1.0.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.40.0",
    "exifr": "^7.1.3",
    "nuxt": "3.16.0",
    "nuxt-auth-utils": "0.5.16",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250310.0",
    "@iconify-json/logos": "^1.2.11",
    "@nuxt/eslint": "^1.1.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.21.0",
    "tailwindcss": "4.0.7",
    "typescript": "^5.7.3",
    "wrangler": "^3.112.0"
  },
  "overrides": {
    "vite": "6.2.2",
    "tailwindcss": "4.0.7",
    "@tailwindcss/node": "4.0.7",
    "@tailwindcss/postcss": "4.0.7",
    "@tailwindcss/vite": "4.0.7"
  },
  "resolutions": {
    "tailwindcss": "4.0.7",
    "@tailwindcss/postcss": "4.0.7",
    "@tailwindcss/vite": "4.0.7"
  }
}
