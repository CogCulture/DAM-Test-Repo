# Copy this file to .env.gcp. Never commit .env.gcp.
NUXT_PUBLIC_SITE_URL=https://dam.example.com
DATABASE_PATH=/var/lib/dam/database.sqlite
LOCAL_DAM_STORAGE_DIR=/var/lib/dam/files

# Generate independent values containing at least 32 random characters.
NUXT_SESSION_PASSWORD=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_SESSION_PASSWORD=

# Enable the Google Drive API and configure this exact production callback.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_REDIRECT_URL=https://dam.example.com/api/auth/google

# Optional GitHub sign-in.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Optional RAG processing.
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_EMBED_MODEL=llama-text-embed-v2
RAG_USE_BATCH=false
RAG_PROCESS_TIMEOUT_MS=720000
PYTHON_CMD=/opt/dam-python/bin/python
