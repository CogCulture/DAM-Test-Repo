
NUXT_SESSION_PASSWORD=password-with-at-least-32-characters

# Local Super Admin portal at /superadmin/login (env-based, not a database user)
SUPERADMIN_EMAIL=superadmin@dam.local
SUPERADMIN_PASSWORD=SuperAdmin@12345
SUPERADMIN_SESSION_PASSWORD=local-superadmin-session-password-32

NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth (must exactly match the URI configured in Google Cloud)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://127.0.0.1:3000/api/auth/google
# Optional legacy Google Drive storage flow. Standard Google login remains available.
NUXT_PUBLIC_ENABLE_GDRIVE_STORAGE=false

# RAG parsing, summarization, and semantic search
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_EMBED_MODEL=llama-text-embed-v2
# Real-time mode streams useful progress; enable batch only when long waits are acceptable.
RAG_USE_BATCH=false
# Server-side hard limit in milliseconds (default: 12 minutes).
RAG_PROCESS_TIMEOUT_MS=720000
PYTHON_CMD=python

# Absolute path is supported. Defaults to "<project>/local dam storage".
LOCAL_DAM_STORAGE_DIR=
